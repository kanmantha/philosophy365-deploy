@page "/social"
@inject ApiClient Api
@inject NavigationManager Nav

<div class="page-heading">
    <h1>Connect Social Accounts</h1>
    <p>Link your platform handles. When you add an account with a token, the API checks the credentials against the actual platform before saving it, so only working logins are marked verified. The daily pipeline auto-posts each video to the default account of every platform marked <strong>real</strong>.</p>
</div>

@if (busy)
{
    <div class="spinner-border text-info"></div>
    return;
}

@if (platforms.Any(p => p.mode == "real"))
{
    <div class="alert alert-info">
        <strong>Real posting mode.</strong> Linked accounts are published to the actual platform APIs.
        A platform marked "setup required" needs credentials (<code>Social:*</code> in appsettings) or a real
        access token on the linked account before the daily pipeline can post to it.
    </div>
}

<h2 class="h5 mt-3">Supported platforms</h2>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">Could not load social settings: @loadError</div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    @foreach (var p in platforms)
    {
        var cls = p.mode == "real" && !p.requiresSetup ? "bg-success"
            : p.mode == "real" ? "bg-warning text-dark"
            : "bg-secondary";
        var note = p.mode == "demo" ? "demo - simulated"
            : p.requiresSetup ? "real - setup required"
            : "real";
        <span class="badge p-2 @cls">@p.name — @note</span>
    }
</div>

@if (oauthAvailable.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-semibold me-1">One-click sign-in</span>
            @foreach (var p in oauthAvailable)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartOAuth(p.platform)" disabled="@startingOAuth">Continue with @p.name</button>
            }
            <span class="small text-muted">Opens the platform's own login page; the link is verified automatically.</span>
        </div>
    </div>
}

<h2 class="h5">Linked accounts</h2>
@if (accounts.Count == 0)
{
    <div class="alert alert-secondary">No accounts linked yet. Add one below.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Platform</th>
                <th>Account</th>
                <th>Handle</th>
                <th>Default</th>
                <th>Token</th>
                <th>Status</th>
                <th>Last verified</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in accounts)
            {
                <tr>
                    <td><span class="badge bg-dark">@a.platform</span></td>
                    <td>@a.accountName</td>
                    <td>@@@a.accountHandle</td>
                    <td>@(a.isDefaultForPlatform ? "Yes" : "No")</td>
                    <td>@(a.hasToken ? "Yes" : "No")</td>
                    <td>
                        @if (a.status == "Active" && a.hasToken)
                        {
                            <span class="badge bg-success">Verified</span>
                        }
                        else if (a.status == "Active" && !a.hasToken)
                        {
                            <span class="badge bg-warning text-dark">No token</span>
                        }
                        else if (a.status == "Error")
                        {
                            <span class="badge bg-danger">Error</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@a.status</span>
                        }
                    </td>
                    <td class="small text-muted">@a.lastVerifiedAt?.ToString("g")</td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => Verify(a.id)" disabled="@(verifyingId.HasValue || linking)">@(verifyingId == a.id ? "Verifying..." : "Verify")</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Remove(a.id)" disabled="@(verifyingId.HasValue || linking)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Add account</h2>
<div class="card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-2">
                <select class="form-select" @bind="newPlatform">
                    <option value="YouTubeShorts">YouTube Shorts</option>
                    <option value="TikTok">TikTok</option>
                    <option value="InstagramReels">Instagram Reels</option>
                    <option value="XTwitter">X / Twitter</option>
                    <option value="LinkedIn">LinkedIn</option>
                    <option value="FacebookReels">Facebook Reels</option>
                </select>
            </div>
            <div class="col-md-3"><input class="form-control" @bind="accountName" placeholder="Account name" /></div>
            <div class="col-md-3"><input class="form-control" @bind="accountHandle" placeholder="Handle / channel id" /></div>
            <div class="col-md-2"><input class="form-control" @bind="accessToken" type="password" placeholder="@(newPlatform == "XTwitter" ? "Token" : "Token (optional)")" /></div>
            <div class="col-md-2 d-flex gap-2 align-items-center">
                <label class="small text-muted"><input type="checkbox" class="me-1" @bind="isDefault" />Default</label>
                <button class="btn btn-primary" @onclick="Add" disabled="@linking">@(linking ? "Verifying..." : "Link")</button>
            </div>
        </div>
        @if (newPlatform == "XTwitter")
        {
            <div class="row g-2 mt-1">
                <div class="col-md-6">
                    <label class="form-label small text-muted">X / Twitter OAuth1 token secret (required for X)</label>
                    <input class="form-control" @bind="tokenSecret" type="password" placeholder="OAuth1 token secret" />
                </div>
            </div>
        }
        @if (linking)
        {
            <div class="alert alert-info mt-3 mb-0"><span class="spinner-border spinner-border-sm me-2"></span>Checking credentials with the platform…</div>
        }
        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="alert @(messageError ? "alert-danger" : "alert-success") mt-3 mb-0">@Message</div>
        }
    </div>
</div>

@code {
    private List<PlatformDto> platforms = new();
    private List<SocialAccountDto> accounts = new();
    private List<PlatformDto> oauthAvailable = new();
    private bool busy = true;
    private bool linking;
    private bool startingOAuth;
    private Guid? verifyingId;
    private string newPlatform = "YouTubeShorts";
    private string accountName = string.Empty;
    private string accountHandle = string.Empty;
    private string accessToken = string.Empty;
    private string tokenSecret = string.Empty;
    private bool isDefault = true;
    private string Message = string.Empty;
    private bool messageError;
    private string loadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ApplyOAuthResultAsync();
        try
        {
            await Api.InitializeAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        await LoadAsync();
    }

    private async Task ApplyOAuthResultAsync()
    {
        var uri = Nav.Uri;
        var idx = uri.IndexOf("?oauth=", StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return;
        var decoded = Uri.UnescapeDataString(uri[(idx + 7)..]);
        var sep = decoded.IndexOf(':');
        var platform = sep > 0 ? decoded[..sep] : decoded;
        var rest = sep > 0 ? decoded[(sep + 1)..] : string.Empty;

        if (rest.StartsWith("ok", StringComparison.OrdinalIgnoreCase))
        {
            messageError = false;
            Message = $"{platform} linked successfully and verified with the platform.";
        }
        else
        {
            var detail = rest.StartsWith("error", StringComparison.OrdinalIgnoreCase) ? rest["error".Length..].TrimStart(':', ' ') : string.Empty;
            messageError = true;
            Message = string.IsNullOrWhiteSpace(detail) ? $"Could not link {platform}." : $"Could not link {platform}: {detail}";
        }
        Nav.NavigateTo("/social");
    }

    private async Task LoadAsync()
    {
        busy = true;
        loadError = string.Empty;
        try
        {
            var p = await Api.GetAsync<ApiEnvelope<List<PlatformDto>>>("api/social/platforms");
            platforms = p?.Data ?? new();
            var a = await Api.GetAsync<ApiEnvelope<List<SocialAccountDto>>>("api/social/accounts");
            accounts = a?.Data ?? new();
            oauthAvailable = platforms.Where(x => x.mode == "real" && x.isConfigured && !x.hasLinkedToken).ToList();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task StartOAuth(string platform)
    {
        Message = string.Empty;
        startingOAuth = true;
        try
        {
            var res = await Api.PostEnvelopeAsync<OAuthStartDto>("api/social/oauth/start", new { platform });
            if (res is { Success: true } && !string.IsNullOrEmpty(res.Data?.authorizeUrl))
            {
                Nav.NavigateTo(res.Data.authorizeUrl, forceLoad: true);
                return;
            }
            messageError = true;
            Message = res?.Message ?? "Could not start the sign-in.";
        }
        catch (Exception ex)
        {
            messageError = true;
            Message = ex.Message;
        }
        finally
        {
            startingOAuth = false;
        }
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(accountName) || string.IsNullOrWhiteSpace(accountHandle))
        {
            messageError = true;
            Message = "Account name and handle / channel id are required.";
            return;
        }
        Message = string.Empty;
        linking = true;
        try
        {
            var res = await Api.PostEnvelopeAsync<object>("api/social/accounts",
                new
                {
                    platform = newPlatform,
                    accountName,
                    accountHandle,
                    accessToken = string.IsNullOrEmpty(accessToken) ? null : accessToken,
                    refreshToken = (string?)null,
                    tokenSecret = string.IsNullOrEmpty(tokenSecret) ? null : tokenSecret,
                    isDefaultForPlatform = isDefault
                });
            messageError = res is not { Success: true };
            Message = res?.Message ?? (messageError ? "Could not link the account." : "Added.");
            if (res is { Success: true })
                accountName = accountHandle = accessToken = tokenSecret = string.Empty;
        }
        catch (Exception ex)
        {
            messageError = true;
            Message = ex.Message;
        }
        finally
        {
            linking = false;
        }
        await LoadAsync();
    }

    private async Task Verify(Guid id)
    {
        verifyingId = id;
        Message = string.Empty;
        try
        {
            var res = await Api.PostEnvelopeAsync<object>($"api/social/accounts/{id}/validate");
            messageError = res is not { Success: true };
            Message = res?.Message ?? (messageError ? "Verification failed." : "Re-verified.");
        }
        catch (Exception ex)
        {
            messageError = true;
            Message = ex.Message;
        }
        finally
        {
            verifyingId = null;
        }
        await LoadAsync();
    }

    private async Task Remove(Guid id)
    {
        Message = string.Empty;
        try
        {
            var res = await Api.DeleteEnvelopeAsync<object>($"api/social/accounts/{id}");
            messageError = res is not { Success: true };
            Message = res?.Message ?? "Removed.";
        }
        catch (Exception ex)
        {
            messageError = true;
            Message = ex.Message;
        }
        await LoadAsync();
    }
}
FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS build
WORKDIR /repo

COPY src/ src/
RUN dotnet restore src/AIPhilosophy.Web/AIPhilosophy.Web.csproj

RUN dotnet publish src/AIPhilosophy.Web/AIPhilosophy.Web.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0.10 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
ENTRYPOINT ["sh", "-c", "dotnet AIPhilosophy.Web.dll --urls http://0.0.0.0:${PORT:-8080}"]